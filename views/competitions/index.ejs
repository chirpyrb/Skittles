<h2>Competitions</h2>
<br>

<% const seasons = [...new Set(Competitions.map(comp => comp.seasonStartYear).filter(Boolean))]; %>
<% seasons.forEach(seasonStartYear => { %>
    <div>
        <h3><a href="/competitions/<%= seasonStartYear %>"><%= seasonStartYear %>/<%= String(seasonStartYear + 1).slice(-2) %> season</a></h3>
        <p><%= Competitions.filter(comp => comp.seasonStartYear === seasonStartYear).map(comp => comp.name).join(', ') %></p>
        <p>Status: <%= Competitions.find(comp => comp.seasonStartYear === seasonStartYear).status %></p>
    </div>
<% }) %>

<% if (!seasons.length) { %>
    <p>No seasons are available.</p>
<% } %>