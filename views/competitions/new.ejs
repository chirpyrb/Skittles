<h2>New Competition</h2>
<form action="/competitions" method="post">
    <label>Competition name:</label>
    <input type="text" name="competitionName" value="" required>

    <label>Season name:</label>
    <input type="text" name="seasonName" value="">

    <label>Start date:</label>
    <input type="date" name="seasonStartDate" value="">

    <label>End date:</label>
    <input type="date" name="seasonEndDate" value="">

    <a href="/competitions">Cancel</a>
    <button type="submit">Create</button>
</form>