<h2><%= competition ? competition.name : 'Competition' %></h2>

<% if (!seasons || !seasons.length) { %>
    <p>No seasons created for this competition yet.</p>
<% } else { %>
    <% seasons.forEach(season => { %>
        <div>
            <h3><%= season.name %></h3>
            <p>Status: <%= season.status %></p>
            <% if (season.startDate) { %>
                <p><%= season.startDate %> to <%= season.endDate %></p>
            <% } %>
        </div>
    <% }) %>
<% } %>

<p><a href="/competitions">Back to competitions</a></p>