<div class="directory-toolbar">
    <h2>League team directory</h2>
    <div class="directory-actions">
        <a href="/teams/new" role="button">Add team</a>
        <% if (user && (user.access === 'dev' || user.access === 'LeagueSecretary')) { %>
            <a href="/teams/bulk-upload" role="button">Bulk upload teams</a>
        <% } %>
    </div>
</div>
<% if (allTeams && allTeams.length > 0) { %>
    <% const teamsByLeague = allTeams.reduce((groups, team) => {
        const leagueName = team.league || 'League not set'
        if (!groups[leagueName]) groups[leagueName] = []
        groups[leagueName].push(team)
        return groups
    }, {}) %>
    <table>
        <thead>
            <tr>
                <th>Team Name</th>
                <th>Home Alley</th>
                <th>Home Day</th>
                <th>League</th>
                <th>Division</th>
            </tr>
        </thead>
        <tbody>
            <% Object.keys(teamsByLeague).sort((a, b) => a.localeCompare(b, undefined, { numeric: true })).forEach(leagueName => { %>
                <tr class="team-division-heading">
                    <th colspan="5"><%= leagueName %></th>
                </tr>
                <% teamsByLeague[leagueName].forEach(team => { %>
                <tr>
                    <td>
                        <a href="/teams?teamName=<%= encodeURIComponent(team.teamName || team.name || ('Team ' + team.id)) %>"><strong><%= team.teamName || team.name || ('Team ' + team.id) %></strong></a>
                    </td>
                    <td><%= team.homeAlley || '-' %></td>
                    <td><%= ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'][Number(team.homeNight) - 1] || '-' %></td>
                    <td><%= team.league || '-' %></td>
                    <td><%= team.division || '-' %></td>
                </tr>
                <% }) %>
            <% }) %>
        </tbody>
    </table>
<% } else { %>
    <p>No teams found in the directory.</p>
<% } %>