<label for="newTeamName">Team Name:</label>
<input id="newTeamName" type="text" name="newTeamName" value="" required>

<label for="newTeamAlley">Home Alley:</label>
<select id="newTeamAlley" name="newTeamAlley" required>
    <% alleyList.forEach(alley => { %>
        <option value="<%= alley.id %>"><%= alley.name || alley.AlleyName %></option>
    <% }) %>
</select>

<label for="leagueId">League:</label>
<select id="leagueId" name="leagueId" required>
    <% leagues.forEach(league => { %>
        <option value="<%= league.id %>" <%= (typeof selectedLeagueId !== 'undefined' && Number(selectedLeagueId) === league.id) ? 'selected' : '' %>><%= league.name %></option>
    <% }) %>
</select>