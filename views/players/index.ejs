<div class="directory-toolbar">
    <h2>Player Directory</h2>
    <div class="directory-actions">
        <a href="/players/new" role="button">Add player</a>
        <% if (user && (user.access === 'dev' || user.access === 'LeagueSecretary')) { %>
            <a href="/players/bulk-upload" role="button">Bulk upload players</a>
        <% } %>
    </div>
</div>

<% if (playerList && playerList.length > 0) { %>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Alias</th>
                <th>Team</th>
                <th>Status</th>
                <% if (user && ['dev', 'LeagueSecretary'].includes(user.access)) { %>
                    <th>Action</th>
                <% } %>
            </tr>
        </thead>
        <tbody>
            <% playerList.forEach(p => { %>
                <tr>
                    <td><strong><%= p.firstName %> <%= p.secondName %></strong></td>
                    <td><%= p.alias %></td>
                    <td><%= p.teamName || '-' %></td>
                    <td><%= p.approved ? 'Approved' : 'Pending approval' %></td>
                    <% if (user && ['dev', 'LeagueSecretary'].includes(user.access)) { %>
                        <td>
                            <% if (!p.approved) { %>
                                <form action="/players/approve/<%= p.id %>" method="post">
                                    <button type="submit">Approve</button>
                                </form>
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                    <% } %>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } else { %>
    <p class="muted">No players are currently registered in the database.</p>
<% } %>