<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
    <h2>Player Directory</h2>
    <a href="/players/new" style="text-decoration: none; padding: 8px 16px; background: #28a745; color: white; border-radius: 4px; font-weight: bold;">+ Add New Player</a>
</div>

<% if (playerList && playerList.length > 0) { %>
    <table border="1" cellpadding="6" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-top: 10px;">
        <thead>
            <tr style="background-color: #f2f2f2; text-align: left;">
                <th style="padding: 8px;">Name</th>
                <th style="padding: 8px;">Alias</th>
                <th style="padding: 8px;">Team</th>
            </tr>
        </thead>
        <tbody>
            <% playerList.forEach(p => { %>
                <tr>
                    <td style="padding: 8px; font-weight: bold;"><%= p.firstName %> <%= p.secondName %></td>
                    <td style="padding: 8px;"><%= p.alias %></td>
                    <td style="padding: 8px;"><%= p.teamName || '-' %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } else { %>
    <p style="color: #666; font-style: italic; margin-top: 15px;">No players are currently registered in the database.</p>
<% } %>

<br>
<a href="/players/new" style="text-decoration: none; display: inline-block; padding: 8px 16px; background: #28a745; color: white; border-radius: 4px; font-weight: bold;">+ Add New Player</a>