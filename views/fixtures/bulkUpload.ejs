<h2>Upload fixtures from CSV</h2>

<p>Upload a CSV with these columns: division name, Monday date, home team name, away team name. Use <code>BYE</code> for one team when the other team has a rest week.</p>
<p>The Monday date must use <code>YYYY-MM-DD</code>. The home team's home night determines the fixture day.</p>

<% if (errors && errors.length) { %>
    <div role="alert">
        <strong>No fixtures were imported.</strong>
        <ul>
            <% errors.forEach(error => { %>
                <li><%= error %></li>
            <% }) %>
        </ul>
    </div>
<% } %>

<% if (imported !== null && !errors.length) { %>
    <p role="status"><%= imported %> fixture<%= imported === 1 ? '' : 's' %> imported successfully.</p>
<% } %>

<div class="bulk-upload-panel">
    <form action="/fixtures/bulk-upload" method="post" enctype="multipart/form-data">
        <label for="fixturesCsv">CSV file:</label>
        <input id="fixturesCsv" name="fixturesCsv" type="file" accept=".csv,text/csv" required>
        <button type="submit">Upload fixtures</button>
    </form>
</div>

<p><a href="/fixtures">Back to fixtures</a></p>