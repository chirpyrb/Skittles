<div class="scorecard-container" data-resume-hand="<%= resumeHand || 1 %>">
    <!-- Stepper Header -->
    <div class="stepper-bar">
        <% for (let h = 1; h <= 7; h++) { %>
            <div class="step-pill <%= h === (resumeHand || 1) ? 'active' : '' %>" id="pill-<%= h - 1 %>">Hand <%= h %></div>
        <% } %>
        <div class="step-pill" id="pill-7">Summary</div>
    </div>

    <div class="live-hand-totals" aria-label="Live totals by hand">
        <strong class="live-hand-totals-title">Totals by hand</strong>
        <% for (let h = 1; h <= 7; h++) { %>
            <div class="live-hand-total">
                <span>H<%= h %></span>
                <strong class="live-hand-total-value" data-hand-total="<%= h %>">0</strong>
            </div>
        <% } %>
        <div class="live-hand-total live-hand-grand-total">
            <span>Total</span>
            <strong class="live-hand-total-value" data-grand-total>0</strong>
        </div>
    </div>

    <form id="scorecardForm" action="/fixtures/scorecard" method="post">
        <% for (let h = 1; h <= 7; h++) { %>
            <div id="Hand-<%= h %>" class="step <%= h === (resumeHand || 1) ? 'active' : '' %>">
                <div class="hand-header-card">
                    <h2>Hand <%= h %></h2>
                    <span style="font-size: 0.9em; opacity: 0.85;">Enter scores for all 8 players</span>
                </div>
                
                <table class="player-entry-table">
                    <thead>
                        <tr>
                            <th style="width: 45%;">Player</th>
                            <th style="width: 20%; text-align: center;">Score</th>
                            <th style="width: 15%; text-align: center;">Bolters</th>
                            <th style="width: 10%; text-align: center;">Flopper</th>
                            <th style="width: 10%; text-align: center;">Square</th>
                            <th style="width: 10%; text-align: center;">Chance</th>
                            <th style="width: 20%; text-align: center;">Running Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (let i = 0; i < 8; i++) { %>
                            <%- include('scorecard/_handEntry.ejs', { handNumber: h, player: players[i] || { alias: 'Empty' }, playerIndex: i, savedScores: savedScores }) %>
                        <% } %>
                    </tbody>
                </table>

                <div class="hand-total-banner">
                    <div class="hand-total-stat">
                        <div class="hand-total-label">Hand Total Score</div>
                        <div class="hand-total-value hand-total score hand-<%= h %>">0</div>
                    </div>
                    <div style="width: 1px; height: 36px; background: #cbd5e1;"></div>
                    <div class="hand-total-stat">
                        <div class="hand-total-label">Hand Bolters</div>
                        <div class="hand-total-value hand-total bolters hand-<%= h %>">0</div>
                    </div>
                </div>
            </div>
        <% } %>

        <div id="Game-summary" class="step">
            <div class="hand-header-card" style="background: linear-gradient(135deg, #0f172a, #1e293b);">
                <h2>Match Scorecard Summary</h2>
                <span style="font-size: 0.9em; opacity: 0.85;">Review all hands before final submission</span>
            </div>
            <div style="background: #ffffff; padding: 20px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 12px 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
                <%- include('scorecard/_finalScore.ejs') %>
            </div>
        </div>

        <div class="card-button-container">
            <button type="button" class="btn-card btn-secondary previous">&larr; Previous</button>
            <button type="button" class="btn-card btn-primary next">Next Hand &rarr;</button>
            <button type="submit" class="btn-card btn-success submit-btn" style="display: none;">Submit Scorecard &#10003;</button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const scorecardContainer = document.querySelector('.scorecard-container');
        const form = document.getElementById('scorecardForm');
        const steps = form.querySelectorAll('.step');
        const prevButton = form.querySelector('.previous');
        const nextButton = form.querySelector('.next');
        const handScoreTotals = form.querySelectorAll('.input.score');
        const handBolterTotals = form.querySelectorAll('.input.bolters');
        const eventInputs = form.querySelectorAll('.input.event');
        const scoreEmbellishments = form.querySelectorAll('scoreEmbellishment');
        const saveTimers = new Map();
        const stepPills = scorecardContainer.querySelectorAll('.step-pill');

        const resumeHand = parseInt(form.closest('.scorecard-container').dataset.resumeHand, 10) || 1;
        let currentStep = Math.min(Math.max(resumeHand - 1, 0), steps.length - 1);

        updateButtons();
        updateAllPlayerTotals();
        updateAllHandTotals();

        nextButton.addEventListener('click', () => {
            if (validateForm()) {
                showStep(currentStep + 1);
            }
        });

        prevButton.addEventListener('click', () => {
            showStep(currentStep - 1);
        });

        stepPills.forEach((stepPill, stepIndex) => {
            stepPill.setAttribute('role', 'button');
            stepPill.setAttribute('tabindex', '0');
            stepPill.addEventListener('click', () => showStep(stepIndex));
            stepPill.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    showStep(stepIndex);
                }
            });
        });

        form.addEventListener('submit', (event) => {
            if (!validateForm()) {
                event.preventDefault();
            }
        });

        handScoreTotals.forEach(handScoreTotal => {
            handScoreTotal.addEventListener('input', () => {
                updateHandTotal(handScoreTotal);
                updateAllPlayerTotals();
                updateAllHandTotals();
                queueSaveEntry(handScoreTotal);
            });
            handScoreTotal.addEventListener('change', () => {
                saveEntry(handScoreTotal);
            });
        });

        handBolterTotals.forEach(handBolterTotal => {
            handBolterTotal.addEventListener('input', () => {
                updateHandTotal(handBolterTotal);
                updateAllPlayerTotals();
                updateAllHandTotals();
                queueSaveEntry(handBolterTotal);
            });
            handBolterTotal.addEventListener('change', () => {
                saveEntry(handBolterTotal);
            });
        });

        eventInputs.forEach(eventInput => {
            eventInput.addEventListener('change', () => saveEntry(eventInput));
        });

        async function saveEntry(inputElement) {
            const handNumberMatch = inputElement.className.match(/hand-(\d+)/);
            const handNumber = handNumberMatch ? handNumberMatch[1] : null;
            const playerIndexMatch = inputElement.className.match(/player-(\d+)/);
            const playerIndex = playerIndexMatch ? playerIndexMatch[1] : null;
            if (playerIndex === null || handNumber === null) return;

            const scoreInput = document.getElementById(`score${handNumber}_${playerIndex}`);
            const boltersInput = document.getElementById(`bolters${handNumber}_${playerIndex}`);
            const flopperInput = document.getElementById(`flopper${handNumber}_${playerIndex}`);
            const squareInput = document.getElementById(`square${handNumber}_${playerIndex}`);
            const chanceInput = document.getElementById(`chance${handNumber}_${playerIndex}`);

            const data = {
                handNumber: parseInt(handNumber),
                playerIndex: parseInt(playerIndex),
                score: scoreInput ? (parseInt(scoreInput.value) || 0) : 0,
                bolters: boltersInput ? (parseInt(boltersInput.value) || 0) : 0,
                isFlopper: flopperInput && flopperInput.checked ? 1 : 0,
                isSquare: squareInput && squareInput.checked ? 1 : 0,
                isChance: chanceInput && chanceInput.checked ? 1 : 0
            };

            try {
                fetch('/fixtures/scorecard/entry', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    keepalive: true,
                    body: JSON.stringify(data)
                });
            } catch (e) { console.error("Error submitting entry:", e); }
        }

        function queueSaveEntry(inputElement) {
            const timerKey = inputElement.id;
            clearTimeout(saveTimers.get(timerKey));
            saveTimers.set(timerKey, setTimeout(() => saveEntry(inputElement), 250));
        }

        window.addEventListener('beforeunload', () => {
            [...handScoreTotals, ...handBolterTotals].forEach(input => saveEntry(input));
        });

        function validateForm() {
            const currentInputs = steps[currentStep].querySelectorAll('input, textarea');
            let valid = true;
            currentInputs.forEach(input => {
                if (!input.checkValidity()) {
                    input.reportValidity();
                    valid = false;
                }
            });
            return valid;
        }

        function showStep(stepIndex) {
            if (stepIndex < 0 || stepIndex >= steps.length) return;

            steps[currentStep].classList.remove('active');
            currentStep = stepIndex;
            steps[currentStep].classList.add('active');
            updateButtons();

            if (currentStep === steps.length - 1) {
                populateSummaryTable();
            }
        }

        function updateButtons() {
            stepPills.forEach((p, idx) => {
                p.classList.remove('active');
                if (idx < currentStep) p.classList.add('completed');
                else p.classList.remove('completed');
                if (idx === currentStep) p.classList.add('active');
            });

            if (currentStep === 0) {
                prevButton.style.display = 'none';
            } else {
                prevButton.style.display = 'inline-flex';
            }

            if (currentStep === steps.length - 1) {
                nextButton.style.display = 'none';
                const submitBtn = form.querySelector('button[type="submit"]');
                if (submitBtn) submitBtn.style.display = 'inline-flex';
            } else {
                nextButton.style.display = 'inline-flex';
                const submitBtn = form.querySelector('button[type="submit"]');
                if (submitBtn) submitBtn.style.display = 'none';
            }
        }

        function updateAllPlayerTotals() {
            for (let playerIndex = 0; playerIndex < 8; playerIndex++) {
                let runningTotal = 0;
                for (let handNumber = 1; handNumber <= 7; handNumber++) {
                    const scoreInput = document.getElementById(`score${handNumber}_${playerIndex}`);
                    if (scoreInput) {
                        const scoreVal = parseInt(scoreInput.value) || 0;
                        runningTotal += scoreVal;
                        const runningTotalLabel = document.querySelector(`.running-total.player-${playerIndex}.hand-${handNumber}`);
                        if (runningTotalLabel) {
                            runningTotalLabel.textContent = runningTotal;
                        }
                    }
                }
            }
        }

        function updateHandTotal(handTotal) {
            const handMatch = handTotal.className.match(/hand-(\d+)/);
            const handNumber = handMatch ? handMatch[1] : null;
            if (!handNumber) return;

            const handScores = form.querySelectorAll(`.input.score.hand-${handNumber}`);
            const handBolters = form.querySelectorAll(`.input.bolters.hand-${handNumber}`);

            const handScoreTotalLabel = form.querySelector(`.hand-total.score.hand-${handNumber}`);
            const handBolterTotalLabel = form.querySelector(`.hand-total.bolters.hand-${handNumber}`);

            let scoreTotal = 0;
            let bolterTotal = 0;

            handScores.forEach(handScore => {
                if (parseInt(handScore.value)) {
                    scoreTotal += parseInt(handScore.value);
                }
            });

            handBolters.forEach(handBolter => {
                if (parseInt(handBolter.value)) {
                    bolterTotal += parseInt(handBolter.value);
                }
            });

            if (handScoreTotalLabel) handScoreTotalLabel.textContent = scoreTotal;
            if (handBolterTotalLabel) handBolterTotalLabel.textContent = bolterTotal;
        }

        function updateAllHandTotals() {
            let grandTotal = 0;

            for (let handNumber = 1; handNumber <= 7; handNumber++) {
                let handTotal = 0;
                form.querySelectorAll(`.input.score.hand-${handNumber}`).forEach(input => {
                    handTotal += parseInt(input.value) || 0;
                });

                const totalLabel = document.querySelector(`[data-hand-total="${handNumber}"]`);
                if (totalLabel) totalLabel.textContent = handTotal;
                grandTotal += handTotal;
            }

            const grandTotalLabel = document.querySelector('[data-grand-total]');
            if (grandTotalLabel) grandTotalLabel.textContent = grandTotal;
        }

        function populateSummaryTable() {
            let grandTotalScore = 0;
            let grandTotalBolters = 0;
            let grandTotalFloppers = 0;
            let grandTotalSquares = 0;
            let grandTotalChances = 0;
            const handTotals = [0, 0, 0, 0, 0, 0, 0, 0];

            for (let playerIndex = 0; playerIndex < 8; playerIndex++) {
                let playerTotalScore = 0;
                let playerTotalBolters = 0;
                let playerTotalFloppers = 0;
                let playerTotalSquares = 0;
                let playerTotalChances = 0;

                for (let handNumber = 1; handNumber <= 7; handNumber++) {
                    const scoreInput = document.getElementById(`score${handNumber}_${playerIndex}`);
                    const boltersInput = document.getElementById(`bolters${handNumber}_${playerIndex}`);
                    const flopperInput = document.getElementById(`flopper${handNumber}_${playerIndex}`);
                    const squareInput = document.getElementById(`square${handNumber}_${playerIndex}`);
                    const chanceInput = document.getElementById(`chance${handNumber}_${playerIndex}`);

                    const sVal = scoreInput ? (parseInt(scoreInput.value) || 0) : 0;
                    const bVal = boltersInput ? (parseInt(boltersInput.value) || 0) : 0;
                    const fVal = flopperInput && flopperInput.checked ? 1 : 0;
                    const qVal = squareInput && squareInput.checked ? 1 : 0;
                    const cVal = chanceInput && chanceInput.checked ? 1 : 0;

                    const cell = document.getElementById(`summary-score-${handNumber}-${playerIndex}`);
                    if (cell) cell.textContent = sVal;

                    playerTotalScore += sVal;
                    playerTotalBolters += bVal;
                    playerTotalFloppers += fVal;
                    playerTotalSquares += qVal;
                    playerTotalChances += cVal;
                    handTotals[handNumber] += sVal;
                }

                const playerTotalCell = document.getElementById(`summary-player-total-${playerIndex}`);
                if (playerTotalCell) playerTotalCell.textContent = playerTotalScore;

                const playerBoltersCell = document.getElementById(`summary-player-bolters-${playerIndex}`);
                if (playerBoltersCell) playerBoltersCell.textContent = playerTotalBolters;
                const playerFloppersCell = document.getElementById(`summary-player-floppers-${playerIndex}`);
                if (playerFloppersCell) playerFloppersCell.textContent = playerTotalFloppers;
                const playerSquaresCell = document.getElementById(`summary-player-squares-${playerIndex}`);
                if (playerSquaresCell) playerSquaresCell.textContent = playerTotalSquares;
                const playerChancesCell = document.getElementById(`summary-player-chances-${playerIndex}`);
                if (playerChancesCell) playerChancesCell.textContent = playerTotalChances;

                grandTotalScore += playerTotalScore;
                grandTotalBolters += playerTotalBolters;
                grandTotalFloppers += playerTotalFloppers;
                grandTotalSquares += playerTotalSquares;
                grandTotalChances += playerTotalChances;
            }

            for (let handNumber = 1; handNumber <= 7; handNumber++) {
                const handCell = document.getElementById(`summary-hand-total-${handNumber}`);
                if (handCell) handCell.textContent = handTotals[handNumber];
            }

            const grandTotalCell = document.getElementById(`summary-grand-total`);
            if (grandTotalCell) grandTotalCell.textContent = grandTotalScore;

            const grandBoltersCell = document.getElementById(`summary-grand-bolters`);
            if (grandBoltersCell) grandBoltersCell.textContent = grandTotalBolters;
            const grandFloppersCell = document.getElementById(`summary-grand-floppers`);
            if (grandFloppersCell) grandFloppersCell.textContent = grandTotalFloppers;
            const grandSquaresCell = document.getElementById(`summary-grand-squares`);
            if (grandSquaresCell) grandSquaresCell.textContent = grandTotalSquares;
            const grandChancesCell = document.getElementById(`summary-grand-chances`);
            if (grandChancesCell) grandChancesCell.textContent = grandTotalChances;
        }
    });
</script>