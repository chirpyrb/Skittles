<form id="selectTeamForm" action="/fixtures/scorecard/new/team" method="POST">
    <input type="hidden" name="gameid" value="<%= fixtureInfo.id %>">
    <input type="hidden" name="teamId" value="<%= targetTeamId %>">
    <input type="hidden" name="mode" value="<%= mode %>">
    <div style="background: #f8f9fa; padding: 15px; border-radius: 6px; margin-bottom: 20px; border: 1px solid #dee2e6;">
        <h2>Select Team Sheet</h2>
        <% if (typeof fixtureInfo !== 'undefined' && fixtureInfo) { %>
            <p style="font-size: 1.1em; margin: 10px 0;">
                <strong>Fixture:</strong> <%= fixtureInfo.homeTeam %> vs <%= fixtureInfo.awayTeam %>
            </p>
            <div style="margin-top: 10px; padding: 12px; background: #e9ecef; border-radius: 4px;">
                <div style="margin-bottom: 5px;">
                    <strong>Configuring Team Sheet For:</strong>
                    <span style="font-weight: bold; color: #007bff; font-size: 1.1em; margin-left: 5px;">
                        <%= (typeof targetTeamId !== 'undefined' && targetTeamId == fixtureInfo.awayTeamID) ? (fixtureInfo.awayTeam + ' (Away Team)') : (fixtureInfo.homeTeam + ' (Home Team)') %>
                    </span>
                </div>

                <% if (selectableTeams && selectableTeams.length > 1) { %>
                    <div style="margin-top: 10px; font-size: 0.95em; border-top: 1px solid #ccc; padding-top: 8px;">
                        <span><strong>Switch Team to Manage:</strong> </span>
                        <% if (selectableTeams.includes(String(fixtureInfo.homeTeamID))) { %>
                            <a href="/fixtures/scorecard/new/team?gameid=<%= fixtureInfo.id %>&teamId=<%= fixtureInfo.homeTeamID %>&mode=<%= mode %>" style="margin-right: 12px; padding: 4px 8px; background: <%= targetTeamId == fixtureInfo.homeTeamID ? '#007bff' : '#fff' %>; color: <%= targetTeamId == fixtureInfo.homeTeamID ? '#fff' : '#007bff' %>; text-decoration: none; border-radius: 4px; border: 1px solid #007bff;">
                                <%= fixtureInfo.homeTeam %> (Home)
                            </a>
                        <% } %>
                        <% if (selectableTeams.includes(String(fixtureInfo.awayTeamID))) { %>
                            <a href="/fixtures/scorecard/new/team?gameid=<%= fixtureInfo.id %>&teamId=<%= fixtureInfo.awayTeamID %>&mode=<%= mode %>" style="padding: 4px 8px; background: <%= targetTeamId == fixtureInfo.awayTeamID ? '#007bff' : '#fff' %>; color: <%= targetTeamId == fixtureInfo.awayTeamID ? '#fff' : '#007bff' %>; text-decoration: none; border-radius: 4px; border: 1px solid #007bff;">
                                <%= fixtureInfo.awayTeam %> (Away)
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>

    <div>
        <% for (let i = 1; i <= 8; i++) { %>
            <div style="margin-bottom: 12px;">
                <label style="font-weight: bold; width: 90px; display: inline-block;">Player <%= i %> - </label>
                <select name="player" style="padding: 6px; min-width: 260px;">
                    <%- include('_playerDropdown.ejs', { selectedPlayerId: teamSheet[i - 1] }) %>
                </select>
            </div>
        <% } %>
    </div>

    <div class="button-container" style="margin-top: 25px;">
        <button type="submit" style="padding: 10px 24px; background: #28a745; color: white; border: none; border-radius: 4px; font-weight: bold; font-size: 1.05em; cursor: pointer;">
            <% if (mode === 'substitute' && handFrom > 1) { %>
                Save substitution for hand <%= handFrom %>
            <% } else if (mode === 'correct') { %>
                Save corrected team sheet from hand 1
            <% } else { %>
                Submit Team Sheet
            <% } %>
            &rarr;
        </button>
    </div>
</form>