<h2><%= league.name %></h2>

<h3>League Tables</h3>
<% if (!tables || tables.length === 0) { %>
    <p>No league tables are available for this league.</p>
<% } else { %>
    <% tables.forEach(table => { %>
        <div class="league-table-section">
            <h4 class="table-division-heading"><%= table.competitionName %></h4>
            <% if (!table.standings || table.standings.length === 0) { %>
                <p class="muted">No teams in this division.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="standings-table">
                        <thead>
                            <tr>
                                <th class="col-pos">Pos</th>
                                <th class="col-team">Team</th>
                                <th class="col-num">P</th>
                                <th class="col-num">W</th>
                                <th class="col-num">D</th>
                                <th class="col-num">L</th>
                                <th class="col-num">PF</th>
                                <th class="col-num">PA</th>
                                <th class="col-num">PD</th>
                                <th class="col-pts">Pts</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% 
                                const totalTeams = table.standings.length;
                                table.standings.forEach(row => { 
                                    let zoneClass = '';
                                    if (totalTeams >= 4) {
                                        if (row.rank <= 2) zoneClass = 'promotion-zone';
                                        else if (row.rank > totalTeams - 2) zoneClass = 'relegation-zone';
                                    }
                            %>
                                <tr class="<%= zoneClass %>">
                                    <td class="col-pos"><span class="rank-badge"><%= row.rank %></span></td>
                                    <td class="col-team"><a href="/teams?teamName=<%= encodeURIComponent(row.teamName) %>"><strong><%= row.teamName %></strong></a></td>
                                    <td class="col-num"><%= row.played %></td>
                                    <td class="col-num"><%= row.won %></td>
                                    <td class="col-num"><%= row.drawn %></td>
                                    <td class="col-num"><%= row.lost %></td>
                                    <td class="col-num"><%= row.pinsFor %></td>
                                    <td class="col-num"><%= row.pinsAgainst %></td>
                                    <td class="col-num <%= row.pinDiff > 0 ? 'diff-positive' : (row.pinDiff < 0 ? 'diff-negative' : '') %>"><%= row.pinDiff > 0 ? '+' + row.pinDiff : row.pinDiff %></td>
                                    <td class="col-pts"><strong><%= row.points %></strong></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    <% }) %>
<% } %>
<p><a href="/tables?leagueId=<%= league.id %>" role="button">View full standings &amp; filters</a></p>

<h3>Teams</h3>
<% if (!teams || !teams.length) { %>
    <p>No teams have been added to this league.</p>
<% } else { %>
    <ul>
        <% teams.forEach(t => { %>
            <li><a href="/teams?teamName=<%= encodeURIComponent(t.teamName) %>"><strong><%= t.teamName %></strong></a> (Home Alley: <%= t.homeAlley %>)</li>
        <% }) %>
    </ul>
<% } %>
<p><a href="/teams/new?leagueId=<%= league.id %>" role="button">Add team to this league</a></p>

<h3>Competitions</h3>
<% if (!competitions.length) { %>
    <p>No competitions have been added.</p>
<% } else { %>
    <ul>
        <% competitions.forEach(currentCompetition => { %>
            <li><%= currentCompetition.name %></li>
        <% }) %>
    </ul>
<% } %>
<form action="/leagues/<%= league.id %>/competitions" method="post">
    <label for="competitionName">Competition name</label>
    <input id="competitionName" type="text" name="name" required>
    <button type="submit">Add competition</button>
</form>

<h3>Seasons</h3>
<% if (!seasons.length) { %>
    <p>No seasons have been added.</p>
<% } else { %>
    <ul>
        <% seasons.forEach(season => { %>
            <li><%= season.name %> (<%= season.startDate %> to <%= season.endDate %>)</li>
        <% }) %>
    </ul>
<% } %>
<form action="/leagues/<%= league.id %>/seasons" method="post">
    <label for="seasonName">Season name</label>
    <input id="seasonName" type="text" name="name" required>
    <label for="startDate">Start date</label>
    <input id="startDate" type="date" name="startDate" required>
    <label for="endDate">End date</label>
    <input id="endDate" type="date" name="endDate" required>
    <button type="submit">Add season</button>
</form>
