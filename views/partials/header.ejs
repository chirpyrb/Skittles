<header class="main-header">
    <div class="header-inner">
        <a class="brand" href="/" aria-label="Weymouth and Portland Skittles League home">
            <span class="brand-mark">W</span>
            <span class="brand-copy">
                <strong>Weymouth &amp; Portland</strong>
                <small>Skittles League</small>
            </span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">
            <div class="nav-group">
                <span class="nav-label">Community</span>
                <a href="/pubs">Pubs</a>
                <a href="/teams">Teams</a>
                <a href="/players">Players</a>
                <a href="/alleys">Alleys</a>
            </div>
            <div class="nav-group">
                <span class="nav-label">League</span>
                <a href="/divisions">Divisions</a>
                <a href="/fixtures">Fixtures</a>
                <a href="/competitions">Competitions</a>
            </div>
        </nav>

        <div class="account-links">
            <% if (locals.user) { %>
                <a href="/users/profile">Profile</a>
                <a class="account-action" href="/users/logout">Log out</a>
            <% } else { %>
                <a href="/users/login/">Log in</a>
                <a class="account-action" href="/users/register">Register</a>
            <% } %>
        </div>
    </div>

</header>